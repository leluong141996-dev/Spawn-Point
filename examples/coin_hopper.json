  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "message('Collect every coin to open the door!')"
      ]
    },
    {
      "on": "Coin.collected",
      "if": "count('Coin') == 0",
      "do": [
        "Door.open()",
        "message('The door is open!')"
      ]
    },
    {
      "on": "Slime.died",
      "do": [
        "add_score(5)"
      ]
    },
    {
      "on": "Frog.died",
      "do": [
        "add_score(10)"
      ]
    },
    {
      "on": "Exit.triggered",
      "do": [
        "win()"
      ]
    }
  ]
