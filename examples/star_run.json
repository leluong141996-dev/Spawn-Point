  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "message('Destroy the Warship!')"
      ]
    },
    {
      "on": "Drone.died",
      "do": [
        "add_score(5)"
      ]
    },
    {
      "on": "Drone.died",
      "if": "randf() < 0.1",
      "do": [
        "spawn('PowerUp')"
      ]
    },
    {
      "on": "Saucer.died",
      "do": [
        "add_score(10)"
      ]
    },
    {
      "on": "Saucer.died",
      "if": "randf() < 0.14",
      "do": [
        "spawn('PowerUp')"
      ]
    },
    {
      "on": "Hunter.died",
      "do": [
        "add_score(15)"
      ]
    },
    {
      "on": "Hunter.died",
      "if": "randf() < 0.16",
      "do": [
        "spawn('PowerUp')"
      ]
    },
    {
      "on": "Cruiser.died",
      "do": [
        "add_score(25)"
      ]
    },
    {
      "on": "Cruiser.died",
      "if": "randf() < 0.3",
      "do": [
        "spawn('PowerUp')"
      ]
    },
    {
      "on": "PowerUp.collected",
      "do": [
        "Player.power_up()",
        "sound('powerup')"
      ]
    },
    {
      "on": "Lair.WaveSpawner.cleared",
      "do": [
        "message('WARNING! The Warship is coming!')",
        "shake(0.5)",
        "BossGate.start()"
      ]
    },
    {
      "on": "Warship.died",
      "do": [
        "add_score(250)",
        "message('The Warship is destroyed!')",
        "win()"
      ]
    }
  ]
}
