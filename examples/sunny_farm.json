  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "set_var('score_label', 'MONEY')",
        "add_score(15)",
        "message('Earn $350 in 3 days!')"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 4",
      "do": [
        "message('Space: till, plant, water, fish, chop')"
      ]
    },
    {
      "on": "GameState.score_changed",
      "if": "score >= 350",
      "do": [
        "message('What a harvest!')",
        "win()"
      ]
    },
    {
      "on": "Player.FarmDays.season_ended",
      "if": "score < 350",
      "do": [
        "message('The season is over')",
        "lose()"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 12",
      "do": [
        "message('Sell crops, eggs, milk and wood at the shipping bin')"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 25",
      "do": [
        "message('Crows are coming! Chase them off with X')"
      ]
    },
    {
      "on": "Crow.died",
      "do": [
        "add_score(2)"
      ]
    }
  ]
}
