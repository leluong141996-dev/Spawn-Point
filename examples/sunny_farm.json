  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "set_var('time_limit', 180)",
        "set_var('score_label', 'MONEY')",
        "message('Earn $250 before sunset!')"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 4",
      "do": [
        "message('Space: plant, water, harvest, collect eggs, chop trees')"
      ]
    },
    {
      "on": "GameState.score_changed",
      "if": "score >= 250",
      "do": [
        "message('What a harvest!')",
        "win()"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds >= 180",
      "do": [
        "message('The sun has set')",
        "lose()"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 12",
      "do": [
        "message('Sell crops, eggs, milk and wood at the shipping bin')"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 25",
      "do": [
        "message('Crows are coming! Chase them off with X')"
      ]
    },
    {
      "on": "Crow.died",
      "do": [
        "add_score(2)"
      ]
    }
  ]
}
