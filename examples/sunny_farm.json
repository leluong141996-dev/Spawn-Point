    "legend": {
      "#": "solid",
      "P": "Farmhand",
      "f": "Plot",
      "M": "Stall",
      "c": "CrowNest"
    }
  },
  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "set_var('time_limit', 180)",
        "set_var('score_label', 'MONEY')",
        "message('Earn $250 before sunset! Space: plant, water, harvest')"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 25",
      "do": [
        "message('Crows! Shoo them away with X')"
      ]
    },
    {
      "on": "GameState.score_changed",
      "if": "score >= 250",
      "do": [
        "message('What a harvest!')",
        "win()"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds >= 180",
      "do": [
        "message('The sun has set')",
        "lose()"
      ]
    }
  ]
}
