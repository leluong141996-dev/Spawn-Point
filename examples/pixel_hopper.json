  "level": {
    "map": [
      "....................................................",
      "....................................................",
      "....................................................",
      "....................................................",
      "............................................C.......",
      "............CC.............................===......",
      "...........====.....................................",
      ".............................CC........CC...........",
      ".......CC...............C...====......====..........",
      "......====.........C................................",
      ".......................###..........................",
      "..P............S.......###.S...^^...CS....F.H...D.E.",
      "##################...############..#################",
      "##################...############..#################"
    ],
    "legend": {
      "#": "solid",
      "=": "oneway",
      "P": "Player",
      "S": "Slime",
      "F": "Frog",
      "^": "Spikes",
      "C": "Coin",
      "H": "Heart",
      "D": "Door",
      "E": "Exit"
    }
  },
  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "message('Collect every coin to open the door!')"
      ]
    },
    {
      "on": "Coin.collected",
      "if": "count('Coin') == 0",
      "do": [
        "Door.open()",
        "message('The door is open!')"
      ]
    },
    {
      "on": "Slime.died",
      "do": [
        "add_score(5)"
      ]
    },
    {
      "on": "Frog.died",
      "do": [
        "add_score(10)"
      ]
    },
    {
      "on": "Exit.triggered",
      "do": [
        "win()"
      ]
    }
  ]
}