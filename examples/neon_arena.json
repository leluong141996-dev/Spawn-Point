  },
  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "message('Score 200 to clear the arena!')"
      ]
    },
    {
      "on": "Chaser.died",
      "do": [
        "add_score(10)"
      ]
    },
    {
      "on": "Shooter.died",
      "do": [
        "add_score(25)",
        "shake(0.3)"
      ]
    },
    {
      "on": "GameState.score_changed",
      "if": "score >= 200",
      "do": [
        "message('Arena cleared!')",
        "win()"
      ]
    }
  ]
}