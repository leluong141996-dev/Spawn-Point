  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "set_var('score_label', 'GOLD')",
        "message('Click a pad to build a tower! 1: archer, 2: cannon')"
      ]
    },
    {
      "on": "Goblin.died",
      "do": [
        "add_score(4)"
      ]
    },
    {
      "on": "Wolf.died",
      "do": [
        "add_score(4)"
      ]
    },
    {
      "on": "Orc.died",
      "do": [
        "add_score(14)"
      ]
    },
    {
      "on": "Cave.WaveSpawner.cleared",
      "do": [
        "message('The castle stands!')",
        "win()"
      ]
    }
  ]
