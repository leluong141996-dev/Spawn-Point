  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "message('Mom was taken! Find the key and save her!')"
      ]
    },
    {
      "on": "Key.collected",
      "do": [
        "Cage.open()",
        "message('The cage is open - go to Mom!')"
      ]
    },
    {
      "on": "Mom.triggered",
      "do": [
        "message('You saved Mom!')",
        "win()"
      ]
    },
    {
      "on": "Slime.died",
      "do": [
        "add_score(5)"
      ]
    },
    {
      "on": "Bat.died",
      "do": [
        "add_score(10)"
      ]
    },
    {
      "on": "Thrower.died",
