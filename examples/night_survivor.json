  "rules": [
    {
      "on": "Game.ready",
      "do": [
        "set_var('time_limit', 180)",
        "message('Survive 3 minutes! Collect gems to level up')"
      ]
    },
    {
      "on": "Bat.died",
      "do": [
        "spawn('Gem')"
      ]
    },
    {
      "on": "Zombie.died",
      "do": [
        "spawn('BigGem')",
        "add_score(5)"
      ]
    },
    {
      "on": "Archer.died",
      "do": [
        "spawn('BigGem')",
        "add_score(10)"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 20",
      "do": [
        "message('Zombies rise from the graves!')"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds == 60",
      "do": [
        "message('Skeleton archers!')"
      ]
    },
    {
      "on": "GameState.second_passed",
      "if": "event.seconds >= 180",
      "do": [
        "message('You survived the night!')",
        "win()"
      ]
    }
  ]
