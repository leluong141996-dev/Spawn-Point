extends Node
## Autoload "Sfx": pooled one-shot sound playback with pitch variation.
## Sounds are loaded from res://sfx/<name>.wav (generated by the compiler).

const SFX_PATH := "res://sfx/%s.wav"
const VOICES := 12

var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _streams := {}
var _combo := {}  # name -> {"until": msec, "step": int}
var music_on := true
var _music: AudioStreamPlayer


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)


## Plays sound [param sound_name]. [param pitch_variance] randomizes pitch by ±that fraction.
func play(sound_name: String, pitch_variance := 0.08, volume_db := 0.0, pitch := 1.0) -> void:
	var stream := _stream(sound_name)
	if stream == null:
		return
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = maxf(0.05, pitch * (1.0 + randf_range(-pitch_variance, pitch_variance)))
	p.play()


## Like play(), but each call within [param window] seconds of the previous one is a semitone
## higher (coin pickup chains).
func play_combo(sound_name: String, window := 0.8, max_steps := 12) -> void:
	var now := Time.get_ticks_msec()
	var c: Dictionary = _combo.get(sound_name, {"until": 0, "step": -1})
	c.step = mini(c.step + 1, max_steps) if now < c.until else 0
	c.until = now + int(window * 1000.0)
	_combo[sound_name] = c
	play(sound_name, 0.0, 0.0, pow(2.0, c.step / 12.0))


## Plays res://sfx/<name>.wav on repeat as background music (quietly). Does nothing when there is none.
func play_music(sound_name := "music", volume_db := -12.0) -> void:
	var stream := _stream(sound_name)
	if stream == null:
		return
	if _music == null:
		_music = AudioStreamPlayer.new()
		_music.name = "Music"
		add_child(_music)
		_music.finished.connect(func() -> void:
			if music_on:
				_music.play())
	_music.stream = stream
	_music.volume_db = volume_db
	if music_on:
		_music.play()


## Turns the background music on or off (it stays off until turned on again).
func set_music_on(on: bool) -> void:
	music_on = on
	if _music:
		if on and not _music.playing:
			_music.play()
		elif not on:
			_music.stop()


func has_sound(sound_name: String) -> bool:
	return _stream(sound_name) != null


func _stream(sound_name: String) -> AudioStream:
	if sound_name.is_empty():
		return null
	if _streams.has(sound_name):
		return _streams[sound_name]
	var path := SFX_PATH % sound_name
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	_streams[sound_name] = s
	return s
